// Called only by the genuine scoped GameCore exporter. Notification entries
// are supplied from the actual GC typed collection; an arbitrary DB table is
// not accepted as that producer. The supplier must return its real write count.
static std::pair<std::size_t,std::size_t> native_gamecore_register_enums_owned(lua_State*L){
    native_gamecore_export_current_owned(L);
    std::size_t groups=0,members=0;
    for(const auto&e:native_gamecore_enum_events){
        native_gamecore_export_current_owned(L);
        switch(e.kind){
        case 0:
            lua_getfield(L,LUA_GLOBALSINDEX,e.name);
            if(lua_isnil(L,-1)){lua_pop(L,1);lua_newtable(L);lua_pushvalue(L,-1);lua_setfield(L,LUA_GLOBALSINDEX,e.name);}
            ++groups;break;
        case 1:lua_pushinteger(L,static_cast<lua_Integer>(e.value));lua_setfield(L,-2,e.name);++members;break;
        case 2:lua_pushnumber(L,static_cast<lua_Number>(e.value));lua_setfield(L,-2,e.name);++members;break;
        case 3:if(!lua_checkstack(L,1))return (luaL_error(L,"GameCore enum stack growth failed"),std::pair<std::size_t,std::size_t>{});lua_pop(L,1);break;
        case 4:members+=native_gamecore_register_notification_entries_owned(L);break;
        case 5:members+=native_gamecore_register_mission_entries_owned(L);break;
        default:return (luaL_error(L,"GameCore enum recipe kind changed"),std::pair<std::size_t,std::size_t>{});
        }
        native_gamecore_export_current_owned(L);
    }
    // SDK leaves GameOptionTypes on the pRegister C frame: no fabricated
    // EnumEnd is added. The enclosing protected zero-result C call discards it.
    return {groups,members};
}
